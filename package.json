{
  "name": "bugwarden",
  "version": "3.2.1",
  "description": "BugWarden is an open-source Node.js module that guards your applications against bugs and errors. With integrated error handling and reporting, it ensures real-time monitoring of server-side issues, alerting you on services like Slack and email, helping you maintain robust and reliable software.",
  "main": "./dist/app.js",
  "module": "./dist/app.mjs",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.mjs",
      "require": "./dist/app.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.mjs",
      "require": "./dist/fastify.js"
    },
    "./koa": {
      "types": "./dist/koa.d.ts",
      "import": "./dist/koa.mjs",
      "require": "./dist/koa.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "tsc",
    "test": "vitest run",
    "build": "tsup src/app.ts src/fastify.ts src/koa.ts --format cjs,esm --dts",
    "ci": "npm run lint && npm run test && npm run build",
    "release": "npm run lint && npm run test && npm run build && changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Bugs-point/bug-warden.git"
  },
  "author": "bugs-point",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Bugs-point/bug-warden/issues"
  },
  "homepage": "https://github.com/Bugs-point/bug-warden#readme",
  "dependencies": {
    "express": "^4.18.2",
    "fastify-plugin": "^4.5.1"
  },
  "peerDependencies": {
    "fastify": ">=4.0.0",
    "koa": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "koa": {
      "optional": true
    }
  },
  "keywords": [
    "express-middleware",
    "express-logger",
    "http-logger",
    "request-logger",
    "api-logging",
    "error-logging",
    "error-monitoring",
    "slack-notifications",
    "slack-alerts",
    "discord-webhook",
    "webhooks",
    "incident-alerting",
    "http-status-codes",
    "server-monitoring",
    "application-monitoring",
    "observability",
    "node-logging",
    "structured-logging",
    "json-logger",
    "morgan-alternative",
    "developer-tools",
    "nodejs",
    "javascript",
    "web-development",
    "backend",
    "debugging",
    "error-handling",
    "api-monitoring",
    "real-time-alerts",
    "error-handler-middleware",
    "uncaught-exceptions",
    "zero-config",
    "crash-reporting",
    "fastify",
    "fastify-plugin",
    "koa",
    "koa-middleware"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/express": "^4.17.21",
    "@types/koa": "^2.15.2",
    "@types/node": "^20.10.6",
    "@types/supertest": "^7.2.1",
    "fastify": "^4.29.1",
    "koa": "^2.16.4",
    "supertest": "^7.2.2",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  }
}
